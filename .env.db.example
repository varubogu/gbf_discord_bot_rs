#------------------------------------------------------------------
# core
#------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_DB=postgres
POSTGRES_PASSWORD=postgres
TZ=UTC  # タイムゾーンを明示的にUTCに設定


#------------------------------------------------------------------
# Database
#------------------------------------------------------------------

# データベース接続情報（共通）
DB_PORT=5432
DB_NAME=gbf_bot_db


# データベースロール別接続情報
# アプリケーション側でDbRoleを指定して適切なロールを選択します

# ロール1: SYSTEM（スケジューラー・システム処理用）
# 用途: バックグラウンドタスク、スケジュール通知処理
# 権限: master SELECT only, guild_master/worker CRUD, RLS適用なし（BYPASSRLS）
SYSTEM_DB_USER=gbf_bot_system
SYSTEM_DB_PASSWORD=change_this_system_password

# ロール2: GUILD（guild単位のコマンド実行用）
# 用途: Discordコマンド実行、ギルドデータ更新
# 権限: master SELECT only, guild_master/worker CRUD, RLS適用あり（guild_id制限）
GUILD_DB_USER=gbf_bot_guild
GUILD_DB_PASSWORD=change_this_guild_password

# ロール3: GLOBAL（グローバルデータ更新用）
# 用途: スプレッドシート同期、マスターデータ更新
# 権限: master CRUD, guild_master/worker CRUD, RLS適用なし（BYPASSRLS）
GLOBAL_DB_USER=gbf_bot_global
GLOBAL_DB_PASSWORD=change_this_global_password

# ロール4: ADMIN（マイグレーション・管理用）
# 用途: マイグレーション実行、スキーマ変更
# 権限: 全スキーマ CRUD, RLS適用なし（BYPASSRLS）
ADMIN_DB_USER=gbf_bot_admin
ADMIN_DB_PASSWORD=change_this_admin_password

# ロール5: CLEANUP（メンテナンス用）
# 用途: 古いデータのクリーンアップ実行
# 権限: workerの対象テーブルに対するDELETE/SELECT（BYPASSRLS）
CLEANUP_DB_USER=gbf_bot_cleanup
CLEANUP_DB_PASSWORD=change_this_cleanup_password


# 使用例（コード内で DbRole を指定）:
# - DbRole::Guild:  通常のDiscordコマンド実行
# - DbRole::System: スケジューラー処理
# - DbRole::Global: スプレッドシート同期
# - DbRole::Admin:  マイグレーション実行
# - Cleanupロール: .env.maintenance の DB_USER/DB_PASSWORD で使用
