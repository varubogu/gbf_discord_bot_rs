#------------------------------------------------------------------
# core
#------------------------------------------------------------------

# Discord Bot Token
DISCORD_TOKEN=

# log level
RUST_LOG=debug
#RUST_LOG=info

#------------------------------------------------------------------
# Database
#------------------------------------------------------------------

# データベース接続情報（共通）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gbf_bot_db

# データベースロール別接続情報
# アプリケーション側でDbRoleを指定して適切なロールを選択します

# ロール1: SYSTEM（スケジューラー・システム処理用）
# 用途: バックグラウンドタスク、スケジュール通知処理
# 権限: master SELECT only, guild_master/worker CRUD, RLS適用なし（BYPASSRLS）
SYSTEM_DB_USER=gbf_bot_system
SYSTEM_DB_PASSWORD=change_this_system_password

# ロール2: GUILD（guild単位のコマンド実行用）
# 用途: Discordコマンド実行、ギルドデータ更新
# 権限: master SELECT only, guild_master/worker CRUD, RLS適用あり（guild_id制限）
GUILD_DB_USER=gbf_bot_guild
GUILD_DB_PASSWORD=change_this_guild_password

# ロール3: GLOBAL（グローバルデータ更新用）
# 用途: スプレッドシート同期、マスターデータ更新
# 権限: master CRUD, guild_master/worker CRUD, RLS適用なし（BYPASSRLS）
GLOBAL_DB_USER=gbf_bot_global
GLOBAL_DB_PASSWORD=change_this_global_password

# ロール4: ADMIN（マイグレーション・管理用）
# 用途: マイグレーション実行、スキーマ変更
# 権限: 全スキーマ CRUD, RLS適用なし（BYPASSRLS）
ADMIN_DB_USER=gbf_bot_admin
ADMIN_DB_PASSWORD=change_this_admin_password

# postgres管理者ユーザー（setup_db_roles.sh実行時に使用）
DB_ADMIN_USER=postgres

# 使用例（コード内で DbRole を指定）:
# - DbRole::Guild:  通常のDiscordコマンド実行
# - DbRole::System: スケジューラー処理
# - DbRole::Global: スプレッドシート同期
# - DbRole::Admin:  マイグレーション実行


#------------------------------------------------------------------
# global settings
#------------------------------------------------------------------

# Bot管理者専用サーバーのID
BOT_ADMIN_SERVER_ID=123456789012345678

# Googleスプレッドシートアクセス用サービスアカウントキーファイル
# 例: /path/to/service-account-key.json
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# グローバルのスプレッドシートID（全ギルド共通のマスターデータ）
# スプレッドシートURLの "https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit" 部分
GLOBAL_SPREADSHEET_ID=

#------------------------------------------------------------------
# test
#------------------------------------------------------------------

# bot environment
TEST_DISCORD_TOKEN=

# テスト用データベース接続情報（本番と同じ構成）
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=gbf_bot_test_db

# テスト用データベースロール別接続情報
# ロール1: SYSTEM（スケジューラー・システム処理用）
TEST_SYSTEM_DB_USER=gbf_bot_test_system
TEST_SYSTEM_DB_PASSWORD=change_this_test_system_password

# ロール2: GUILD（guild単位のコマンド実行用）
TEST_GUILD_DB_USER=gbf_bot_test_guild
TEST_GUILD_DB_PASSWORD=change_this_test_guild_password

# ロール3: GLOBAL（グローバルデータ更新用）
TEST_GLOBAL_DB_USER=gbf_bot_test_global
TEST_GLOBAL_DB_PASSWORD=change_this_test_global_password

# ロール4: ADMIN（マイグレーション・管理用）
TEST_ADMIN_DB_USER=gbf_bot_test_admin
TEST_ADMIN_DB_PASSWORD=change_this_test_admin_password

# CI environment flag (optional, for continuous integration)
CI=

