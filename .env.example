#---------------
# core
#---------------

# Discord Bot Token
DISCORD_TOKEN=

# Individual database connection settings
DATABASE_URL=postgres://gbf_bot_user:gbf_bot_password@localhost:5432/gbf_bot_db
MIGRATION_URL=postgres://migration_user:migration_password@localhost:5432/gbf_bot_db

# Bot管理者専用サーバーのID
BOT_ADMIN_SERVER_ID=123456789012345678

# Googleスプレッドシートアクセス用サービスアカウントキーファイル
# 例: /path/to/service-account-key.json
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=

# グローバルのスプレッドシートID（全ギルド共通のマスターデータ）
# スプレッドシートURLの "https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit" 部分
GLOBAL_SPREADSHEET_ID=

# log level
RUST_LOG=debug
#RUST_LOG=info


#---------------
# test
#---------------

# bot environment
TEST_DISCORD_TOKEN=

# database
TEST_DATABASE_URL=postgres://gbf_bot_test_user:gbf_bot_test_password@localhost:5432/gbf_bot_test_db


#---------------
# env
#---------------

# CI environment flag (optional, for continuous integration)
CI=

# database initialize environment
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
DB_HOST=localhost
DB_PORT=5432
