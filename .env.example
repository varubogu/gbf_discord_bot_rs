# Discord Bot Token
DISCORD_TOKEN=

# Database URL for PostgreSQL
# Example: postgresql://username:password@localhost:5432/database_name
DATABASE_URL=

# Configuration folder path (optional, defaults to ".")
CONFIG_FOLDER=

# Test database URL for integration tests
# Example: postgresql://username:password@localhost:5432/test_database_name
TEST_DATABASE_URL=

# CI environment flag (optional, for continuous integration)
CI=